# Server Configuration
PORT=8080
NODE_ENV=development

# Database Connection (Supabase PostgreSQL)
# 1. DATABASE_URL: Transaction Pooler URL (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. DIRECT_URL: Direct Connection (Port 5432) สำหรับ Prisma Migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Security & Authentication
JWT_SECRET="super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,https://matchstock-staging.web.app,https://matchstock-prod.web.app"
