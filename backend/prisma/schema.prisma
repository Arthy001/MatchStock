model CycleCount {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  countNumber      String           @map("count_number") @db.VarChar(100)
  warehouseId      String           @map("warehouse_id") @db.Uuid
  binLocationId    String?          @map("bin_location_id") @db.Uuid
  status           CycleCountStatus @default(open)
  missingCount     Int?             @map("missing_count")
  foundCount       Int?             @map("found_count")
  netVarianceCount Int?             @map("net_variance_count")
  notes            String?          @db.VarChar(1000)
  openedAt         DateTime         @map("opened_at")
  /// Distinct from countedTags.length > 0 - a genuinely all-missing count
  /// (submitted with zero found tags) is otherwise indistinguishable from
  /// "never submitted", which used to block close() entirely. Set once,
  /// the first (or any re-)submitCount() call, regardless of how many
  /// tags were actually counted.
  submittedAt      DateTime?        @map("submitted_at")
  closedAt         DateTime?        @map("closed_at")
  /// Approval is a separate step from closing (2026-08-19), matching a
  /// reference schema's DRAFT/IN_PROGRESS/COMPLETED/APPROVED lifecycle -
  /// close() only computes+previews the variance, approve() is what
  /// actually applies it to tag state. Same actorType/actorId pair
  /// convention as createdBy/updatedBy elsewhere in this schema, not a
  /// plain User FK, so a device/system actor could approve too if ever
  /// needed (not just a human User row).
  approvedByType   String?          @map("approved_by_type") @db.VarChar(20)
  approvedById     String?          @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?        @map("approved_at")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expectedTags CycleCountExpectedTag[]
  countedTags  CycleCountCountedTag[]

  @@unique([tenantId, countNumber])
  @@index([tenantId])
  @@map("cycle_counts")
}

/// Replaces the old CLOB expectedTagIdsJson column.
model CycleCountExpectedTag {
  id           String @id @default(uuid()) @db.Uuid
  cycleCountId String @map("cycle_count_id") @db.Uuid
  tagId        String @map("tag_id") @db.VarChar(64)

  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)

  @@unique([cycleCountId, tagId])
  @@map("cycle_count_expected_tags")
}

/// Replaces the old CLOB countedTagIdsJson column.
model CycleCountCountedTag {
  id           String @id @default(uuid()) @db.Uuid
  cycleCountId String @map("cycle_count_id") @db.Uuid
  tagId        String @map("tag_id") @db.VarChar(64)

  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)

  @@unique([cycleCountId, tagId])
  @@map("cycle_count_counted_tags")
}

