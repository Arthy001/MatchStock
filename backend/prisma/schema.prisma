  mock
  manual
}

enum WebhookEventType {
  low_stock_triggered      @map("low_stock.triggered")
  tag_missing              @map("tag.missing")
  goods_receipt_received   @map("goods_receipt.received")
  goods_issue_dispatched   @map("goods_issue.dispatched")
  stock_adjustment_closed  @map("stock_adjustment.closed")
  stock_transfer_completed @map("stock_transfer.completed")
  cycle_count_closed       @map("cycle_count.closed")
}

enum WebhookSubscriptionStatus {
  active
  disabled
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
}

enum AuditActorType {
  user
  device
  system
  platform_admin
  reader_ops_operator
}

// =============================================================================
// Identity / Platform
// =============================================================================

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(255)
  slug         String       @unique @db.VarChar(100)
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  status       TenantStatus @default(active)

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                User[]
  webhookSubscriptions WebhookSubscription[]
  warehouses           Warehouse[]
  taxTypes             TaxType[]
  products             Product[]
  tags                 Tag[]
  devices              Device[]
  tenantMenuItems      TenantMenuItem[]
  units                Unit[]
  brands               Brand[]
  manufacturers        Manufacturer[]
  suppliers            Supplier[]
  companies            Company[]
  categories           Category[]
  barcodeSymbologies   BarcodeSymbology[]
  goodsReceipts        GoodsReceipt[]
  stockBalances        StockBalance[]

  @@map("tenants")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  email               String    @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  fullName            String    @map("full_name") @db.VarChar(255)
  // Plain varchar FK'd to roles.code (see Role model), not a DB enum - the
  // set of valid roles is now admin-managed, runtime data, not a compile-time
  // type. Field name/shape (a bare string) is unchanged from before, so
  // every existing `user.role`/JWT `role` claim/`@Roles()` string-compare
  // call site keeps working without modification.
  role                String    @default("operator") @db.VarChar(50)
  companyId           String?   @map("company_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  // onDelete: Restrict (Postgres default, spelled out here) - a role that's
  // still assigned to at least one user can't be deleted at the DB level
  // even if the service-layer check (RolesService.remove()) is ever
  // bypassed. onUpdate: Cascade - if a role's `code` is ever changed, every
  // user referencing it follows automatically rather than being orphaned.
  roleRef       Role           @relation(fields: [role], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([email])
  @@index([tenantId])
  @@index([companyId])
  @@index([role])
  @@map("users")
}

// Global, platform-admin-managed role catalog (2026-08-18) - replaces the
// old UserRole enum. Shared across every tenant (not per-tenant) by
// explicit product decision: a fixed enum baked into the app was already
// shared across every tenant, so this preserves that shape while making the
// set of roles editable without a code deploy. No `isSystem`/protected flag
// on the original 7 seeded codes (owner/admin/operator/viewer/manager/
// warehouse_staff/purchasing_staff) - by explicit product decision, a
// platform admin can edit or delete any role, built-in or custom, the same
// way. Deleting a role in use by any user is blocked (users.role's FK,
// enforced at both the service layer and the DB) - that's ordinary
// referential-integrity protection, not special-casing.
// `code` (not `id`) is what every `@Roles()` decorator throughout the app
// compares against and what's carried in the JWT `role` claim - renaming a
// role's code silently changes which users satisfy which `@Roles()` checks
// everywhere in the app, immediately, with no code deploy. RolesService/the
// admin DTOs deliberately keep `code` immutable after creation (same
// precedent as SubscriptionPlan.code/ReaderModel.code elsewhere in this
// schema) to avoid that footgun - `name`/`description` remain freely editable.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(1000)
  isActive    Boolean @default(true) @map("is_active")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PlatformAdmin {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String            @unique @db.VarChar(255)
  passwordHash        String            @map("password_hash") @db.VarChar(255)
  fullName            String?           @map("full_name") @db.VarChar(255)
  role                PlatformAdminRole @default(support)
  isActive            Boolean           @default(true) @map("is_active")
  lastLoginAt         DateTime?         @map("last_login_at")
  failedLoginAttempts Int               @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?         @map("locked_until")
  mfaSecret           String?           @map("mfa_secret") @db.VarChar(255)
  mfaEnabled          Boolean           @default(false) @map("mfa_enabled")
  mfaRecoveryCodes    String[]          @map("mfa_recovery_codes")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens PlatformRefreshToken[]

  @@map("platform_admins")
}

model PlatformRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_refresh_tokens")
}

// =============================================================================
// Billing
// =============================================================================

model SubscriptionPlan {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique @db.VarChar(50)
  name          String               @db.VarChar(255)
  type          SubscriptionPlanType
  billingCycle  BillingCycle         @map("billing_cycle")
  priceMinor    BigInt               @map("price_minor")
  currency      String               @default("THB") @db.VarChar(3)
  trialDays     Int                  @default(0) @map("trial_days")
  description   String?              @db.VarChar(1000)
  features      Json?
  maxUsers      Int?                 @map("max_users")
  maxWarehouses Int?                 @map("max_warehouses")
  maxProducts   Int?                 @map("max_products")
  maxDevices    Int?                 @map("max_devices")
  maxTags       Int?                 @map("max_tags")
  isActive      Boolean              @default(true) @map("is_active")
  sortOrder     Int                  @default(0) @map("sort_order")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

model Subscription {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  planCode           String               @map("plan_code") @db.VarChar(50)
  type               SubscriptionPlanType
  status             String               @db.VarChar(25)
  billingCycle       BillingCycle         @map("billing_cycle")
  unitPriceMinor     BigInt               @map("unit_price_minor")
  quantity           Int                  @default(1)
  currency           String               @default("THB") @db.VarChar(3)
  startsAt           DateTime             @map("starts_at")
  currentPeriodStart DateTime?            @map("current_period_start")
  currentPeriodEnd   DateTime?            @map("current_period_end")
  trialEndsAt        DateTime?            @map("trial_ends_at")
  graceEndsAt        DateTime?            @map("grace_ends_at")
  cancelAtPeriodEnd  Boolean              @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?            @map("cancelled_at")
  endedAt            DateTime?            @map("ended_at")
  gatewayCustomerId  String?              @map("gateway_customer_id") @db.VarChar(255)
  gatewayCardId      String?              @map("gateway_card_id") @db.VarChar(255)
  notes              String?              @db.VarChar(1000)

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("subscriptions")
}

model Invoice {
  id                 String    @id @default(uuid()) @db.Uuid
  invoiceNumber      String    @unique @map("invoice_number") @db.VarChar(30)
  tenantId           String    @map("tenant_id") @db.Uuid
  subscriptionId     String?   @map("subscription_id") @db.Uuid
  rentalAssignmentId String?   @map("rental_assignment_id") @db.Uuid
  kind               String    @db.VarChar(20)
  status             String    @db.VarChar(20)
  subtotalMinor      BigInt    @map("subtotal_minor")
  taxMinor           BigInt    @default(0) @map("tax_minor")
  totalMinor         BigInt    @map("total_minor")
  amountPaidMinor    BigInt    @default(0) @map("amount_paid_minor")
  taxPercent         Float     @default(7) @map("tax_percent")
  currency           String    @default("THB") @db.VarChar(3)
  periodStart        DateTime? @map("period_start")
  periodEnd          DateTime? @map("period_end")
  issuedAt           DateTime  @map("issued_at")
  dueAt              DateTime? @map("due_at")
  paidAt             DateTime? @map("paid_at")
  voidedAt           DateTime? @map("voided_at")
  description        String?   @db.VarChar(500)
  metadata           Json?

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines InvoiceLine[]

  @@index([tenantId])
  @@map("invoices")
}

model InvoiceLine {
  id              String  @id @default(uuid()) @db.Uuid
  invoiceId       String  @map("invoice_id") @db.Uuid
  lineType        String  @map("line_type") @db.VarChar(20)
  description     String  @db.VarChar(500)
  quantity        Int     @default(1)
  unitAmountMinor BigInt  @map("unit_amount_minor")
  amountMinor     BigInt  @map("amount_minor")
  refType         String? @map("ref_type") @db.VarChar(30)
  refId           String? @map("ref_id") @db.Uuid
  sortOrder       Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  invoiceId        String?         @map("invoice_id") @db.Uuid
  provider         PaymentProvider
  providerChargeId String?         @unique @map("provider_charge_id") @db.VarChar(255)
  providerSourceId String?         @map("provider_source_id") @db.VarChar(255)
  method           String          @db.VarChar(20)
  status           String          @db.VarChar(20)
  amountMinor      BigInt          @map("amount_minor")
  refundedMinor    BigInt          @default(0) @map("refunded_minor")
  feeMinor         BigInt?         @map("fee_minor")
  netMinor         BigInt?         @map("net_minor")
  currency         String          @default("THB") @db.VarChar(3)
  idempotencyKey   String          @unique @map("idempotency_key") @db.VarChar(64)
  authorizeUri     String?         @map("authorize_uri") @db.VarChar(1000)
  failureCode      String?         @map("failure_code") @db.VarChar(50)
  failureMessage   String?         @map("failure_message") @db.VarChar(500)
  paidAt           DateTime?       @map("paid_at")
  expiresAt        DateTime?       @map("expires_at")
  rawPayload       Json?           @map("raw_payload")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("payments")
}

model Refund {
  id                 String    @id @default(uuid()) @db.Uuid
  paymentId          String    @map("payment_id") @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  providerRefundId   String?   @unique @map("provider_refund_id") @db.VarChar(255)
  amountMinor        BigInt    @map("amount_minor")
  reason             String    @db.VarChar(30)
  status             String    @db.VarChar(20)
  note               String?   @db.VarChar(500)
  initiatedByAdminId String?   @map("initiated_by_admin_id") @db.Uuid
  processedAt        DateTime? @map("processed_at")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("refunds")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String    @db.VarChar(30)
  eventId         String    @unique @map("event_id") @db.VarChar(255)
  eventType       String    @map("event_type") @db.VarChar(60)
  payload         Json
  status          String    @db.VarChar(20)
  processingError String?   @map("processing_error") @db.VarChar(1000)
  receivedAt      DateTime  @map("received_at")
  processedAt     DateTime? @map("processed_at")

  @@map("payment_webhook_events")
}

// =============================================================================
// Products / Warehousing / Tax
// =============================================================================

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  sku                String        @db.VarChar(100)
  code               String        @db.VarChar(50)
  slug               String?       @db.VarChar(150)
  name               String        @db.VarChar(255)
  description        String?       @db.VarChar(1000)
  categoryId         String?       @map("category_id") @db.Uuid
  unitOfMeasure      String?       @map("unit_of_measure") @db.VarChar(20)
  isActive           Boolean       @default(true) @map("is_active")
  isDeleted          Boolean       @default(false) @map("is_deleted")
  isReturnable       Boolean       @default(false) @map("is_returnable")
  unitId             String?       @map("unit_id") @db.Uuid
  brandId            String?       @map("brand_id") @db.Uuid
  manufacturerId     String?       @map("manufacturer_id") @db.Uuid
  widthValue         Float?        @map("width_value")
  lengthValue        Float?        @map("length_value")
  heightValue        Float?        @map("height_value")
  dimensionUnitId    String?       @map("dimension_unit_id") @db.Uuid
  weightValue        Float?        @map("weight_value")
  weightUnitId       String?       @map("weight_unit_id") @db.Uuid
  supplierId         String?       @map("supplier_id") @db.Uuid
  costPriceMinor     BigInt?       @map("cost_price_minor")
  sellingPriceMinor  BigInt?       @map("selling_price_minor")
  currency           String        @default("THB") @db.VarChar(3)
  reorderPoint       Int?          @map("reorder_point")
  minReorderQuantity Int?          @map("min_reorder_quantity")
  barcodeValue       String?       @map("barcode_value") @db.VarChar(64)
  barcodeSymbologyId String?       @map("barcode_symbology_id") @db.Uuid
  taxTypeId          String?       @map("tax_type_id") @db.Uuid
  discountType       DiscountType? @map("discount_type")
  discountValue      Float?        @map("discount_value")
  lowStockNotifiedAt DateTime?     @map("low_stock_notified_at")
  /// AC#3 "Lot Control flag" - whether this product's tags are expected to
  /// carry lot/batch tracking (Tag.lotNumber/productionDate/expiryDate).
  /// A per-product declaration, not enforced at the DB level yet.
  lotControlled      Boolean       @default(false) @map("lot_controlled")
  warrantyPeriodDays Int?          @default(0) @map("warranty_period_days")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images               ProductImage[]
  tags                 Tag[]
  goodsReceiptLines    GoodsReceiptLine[]
  goodsIssueLines      GoodsIssueLine[]
  stockTransferLines   StockTransferLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockBalances        StockBalance[]

  @@unique([tenantId, sku])
  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, barcodeValue])
  @@index([tenantId, reorderPoint])
  @@index([tenantId, brandId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  url       String  @db.VarChar(500)
  sortOrder Int     @default(0) @map("sort_order")
