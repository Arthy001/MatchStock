  rentalEndAt                  DateTime? @map("rental_end_at")
  activatedAt                  DateTime? @map("activated_at")
  actualReturnAt               DateTime? @map("actual_return_at")
  closedAt                     DateTime? @map("closed_at")
  monthlyRateMinor             BigInt    @map("monthly_rate_minor")
  currency                     String    @default("THB") @db.VarChar(3)
  depositAmountMinor           BigInt    @default(0) @map("deposit_amount_minor")
  depositStatus                String    @map("deposit_status") @db.VarChar(20)
  depositPaymentId             String?   @map("deposit_payment_id") @db.Uuid
  depositRefundId              String?   @map("deposit_refund_id") @db.Uuid
  depositRefundedMinor         BigInt    @default(0) @map("deposit_refunded_minor")
  depositForfeitedMinor        BigInt    @default(0) @map("deposit_forfeited_minor")
  depositForfeitReason         String?   @map("deposit_forfeit_reason") @db.VarChar(500)
  conditionOut                 String?   @map("condition_out") @db.VarChar(20)
  conditionOutNote             String?   @map("condition_out_note") @db.VarChar(1000)
  conditionOutPhotos           String[]  @map("condition_out_photos")
  conditionOutCheckedByAdminId String?   @map("condition_out_checked_by_admin_id") @db.Uuid
  conditionOutAt               DateTime? @map("condition_out_at")
  conditionIn                  String?   @map("condition_in") @db.VarChar(20)
  conditionInNote              String?   @map("condition_in_note") @db.VarChar(1000)
  conditionInPhotos            String[]  @map("condition_in_photos")
  conditionInCheckedByAdminId  String?   @map("condition_in_checked_by_admin_id") @db.Uuid
  conditionInAt                DateTime? @map("condition_in_at")
  damageAssessedAt             DateTime? @map("damage_assessed_at")
  damageAssessedByAdminId      String?   @map("damage_assessed_by_admin_id") @db.Uuid
  damageChargeMinor            BigInt    @default(0) @map("damage_charge_minor")
  damageNote                   String?   @map("damage_note") @db.VarChar(1000)
  damageInvoiceId              String?   @map("damage_invoice_id") @db.Uuid
  createdByAdminId             String?   @map("created_by_admin_id") @db.Uuid
  notes                        String?   @db.VarChar(1000)

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shipments RentalShipment[]

  @@index([rentalUnitId])
  @@index([tenantId])
  @@map("rental_assignments")
}

model RentalShipment {
  id                       String    @id @default(uuid()) @db.Uuid
  rentalAssignmentId       String    @map("rental_assignment_id") @db.Uuid
  direction                String    @db.VarChar(10)
  carrier                  String?   @db.VarChar(50)
  trackingNumber           String?   @map("tracking_number") @db.VarChar(100)
  trackingUrl              String?   @map("tracking_url") @db.VarChar(500)
  status                   String    @db.VarChar(25)
  shippedAt                DateTime? @map("shipped_at")
  estimatedDeliveryAt      DateTime? @map("estimated_delivery_at")
  deliveredAt              DateTime? @map("delivered_at")
  recipientName            String?   @map("recipient_name") @db.VarChar(255)
  deliveryConfirmationNote String?   @map("delivery_confirmation_note") @db.VarChar(1000)
  shippingCostMinor        BigInt?   @map("shipping_cost_minor")
  addressSnapshot          Json?     @map("address_snapshot")
  notes                    String?   @db.VarChar(1000)

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rentalAssignment RentalAssignment @relation(fields: [rentalAssignmentId], references: [id], onDelete: Cascade)

  @@index([rentalAssignmentId])
  @@map("rental_shipments")
}

// =============================================================================
// Menu
// =============================================================================

model MenuItem {
  id              String  @id @default(uuid()) @db.Uuid
  parentId        String? @map("parent_id") @db.Uuid
  label           String  @db.VarChar(150)
  icon            String? @db.VarChar(50)
  link            String? @db.VarChar(255)
  allowedRoles    String? @map("allowed_roles") @db.VarChar(100)
  requiredFeature String? @map("required_feature") @db.VarChar(100)
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   MenuItem?        @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[]       @relation("MenuItemTree")
  grants   TenantMenuItem[]

  @@index([parentId])
  @@map("menu_items")
}

model TenantMenuItem {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  // Intentional improvement over the original TypeORM schema (which had no
  // composite unique here, an acknowledged anomaly) - a grant should never
  // be duplicated at the DB level.
  @@unique([tenantId, menuItemId])
  @@index([tenantId])
  @@index([menuItemId])
  @@map("tenant_menu_items")
}

// =============================================================================
// Webhooks / Audit / Security
// =============================================================================

model WebhookSubscription {
  id                 String                    @id @default(uuid()) @db.Uuid
  tenantId           String                    @map("tenant_id") @db.Uuid
  url                String                    @db.VarChar(2000)
  eventTypes         String                    @map("event_types") @db.VarChar(500)
  keyPrefix          String                    @unique @map("key_prefix") @db.VarChar(16)
  encryptedSecret    String                    @map("encrypted_secret") @db.VarChar(255)
  status             WebhookSubscriptionStatus @default(active)
  lastDeliveryAt     DateTime?                 @map("last_delivery_at")
  lastDeliveryStatus WebhookDeliveryStatus?    @map("last_delivery_status")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // A removed integration is tombstoned, not dropped - keeps the audit of
  // who removed it and the meaning of its WebhookDeliveryLog rows. Reads
  // are filtered by the withSoftDelete extension (this model is in its set).
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

model WebhookDeliveryLog {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  eventType      String                @map("event_type") @db.VarChar(50)
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attemptCount   Int                   @default(0) @map("attempt_count")
  responseStatus Int?                  @map("response_status")
  lastError      String?               @map("last_error") @db.VarChar(1000)
  nextRetryAt    DateTime?             @map("next_retry_at")
  createdAt      DateTime              @map("created_at")
  deliveredAt    DateTime?             @map("delivered_at")

  @@index([tenantId])
  @@index([status, nextRetryAt])
  @@map("webhook_delivery_logs")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String?        @map("tenant_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String         @db.VarChar(100)
  targetType String?        @map("target_type") @db.VarChar(50)
  targetId   String?        @map("target_id") @db.VarChar(64)
  ipAddress  String?        @map("ip_address") @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  ip         String   @db.VarChar(64)
  eventType  String   @map("event_type") @db.VarChar(30)
  detail     String?  @db.VarChar(500)
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([ip, occurredAt])
  @@index([occurredAt])
  @@map("security_events")
}
