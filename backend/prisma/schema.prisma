// Master data (2026-08-18) - replaces ProductAttributeOption. Strictly
// per-tenant, by explicit product decision - no shared/master tier (a
// regression from ProductAttributeOption's old master-vs-tenant-tier
// design, deliberately accepted: every tenant now defines its own units
// from scratch, matching the reference schema this was modeled on exactly).
// One table for all three of Product's unit-of-measure slots (unitId,
// dimensionUnitId, weightUnitId) - `type` is what the app validates against
// at write time (e.g. dimensionUnitId must reference a `type: dimension`
// row), replacing ProductAttributeOptionCategory's dimension_unit/
// weight_unit split.
model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  type      UnitType @default(quantity)
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("units")
}

