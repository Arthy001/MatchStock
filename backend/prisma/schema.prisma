model GoodsReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  supplierId        String?  @map("supplier_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  binLocationId     String?  @map("bin_location_id") @db.Uuid
  receiptNumber     String   @map("receipt_number") @db.VarChar(100)
  poNumber          String?  @map("po_number") @db.VarChar(100)
  supplierInvoiceNo String?  @map("supplier_invoice_no") @db.VarChar(100)
  photoUrls         String[] @default([]) @map("photo_urls")
  receivedAt        DateTime @map("received_at")
  notes             String?  @db.VarChar(1000)

  createdByType String?   @map("created_by_type") @db.VarChar(20)
  createdById   String?   @map("created_by_id") @db.Uuid
  updatedByType String?   @map("updated_by_type") @db.VarChar(20)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines     GoodsReceiptLine[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([warehouseId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id              String    @id @default(uuid()) @db.Uuid
  goodsReceiptId  String    @map("goods_receipt_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  quantity        Int // จำนวนที่รับเข้าสมบูรณ์
  damagedQuantity Int       @default(0) @map("damaged_quantity") // จำนวนที่ชำรุดตอนตรวจรับ
  putawayQuantity Int       @default(0) @map("putaway_quantity") // จำนวนที่จัดเก็บเข้า Bin แล้ว
  lotNumber       String?   @map("lot_number") @db.VarChar(100)
  productionDate  DateTime? @map("production_date")
  expiryDate      DateTime? @map("expiry_date")
  unitCostMinor   BigInt?   @map("unit_cost_minor") // ราคาต้นทุนต่อหน่วย (สตางค์)
  binLocationId   String?   @map("bin_location_id") @db.Uuid // null = พักที่ Staging

  createdAt DateTime @default(now()) @map("created_at")

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  binLocation  BinLocation? @relation(fields: [binLocationId], references: [id], onDelete: SetNull)

  @@index([goodsReceiptId])
  @@index([productId])
  @@index([binLocationId])
  @@map("goods_receipt_lines")
}

// =============================================================================
// Stock Balances (Real-time Inventory Balance for Bulk & Serialized Items)
// =============================================================================

model StockBalance {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  binLocationId    String?   @map("bin_location_id") @db.Uuid // null = พักที่ Staging
  productId        String    @map("product_id") @db.Uuid
  lotNumber        String?   @map("lot_number") @db.VarChar(100)
  expiryDate       DateTime? @map("expiry_date")

  quantityOnHand   Int       @default(0) @map("quantity_on_hand")  // จำนวนคงเหลือจริงบนชั้นวาง
  quantityReserved Int       @default(0) @map("quantity_reserved") // จำนวนที่ถูกจองรอจ่ายออก

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  binLocation BinLocation? @relation(fields: [binLocationId], references: [id], onDelete: SetNull)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, binLocationId, productId, lotNumber])
  @@index([tenantId, warehouseId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId, binLocationId])
  @@map("stock_balances")
}

model GoodsIssue {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  issueNumber   String   @map("issue_number") @db.VarChar(100)
