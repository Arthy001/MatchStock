  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentials    DeviceCredential[]
  readerConfig   DeviceReaderConfig?
  antennaConfigs DeviceAntennaConfig[]
  mqttCredential DeviceMqttCredential?
  gpioState      DeviceGpioState?

  @@unique([tenantId, readerId])
  @@index([tenantId])
  @@index([rentalUnitId])
  @@index([readerModelId])
  @@index([binLocationId])
  @@index([warehouseId])
  @@map("devices")
}

model DeviceCredential {
  id              String                 @id @default(uuid()) @db.Uuid
  deviceId        String                 @map("device_id") @db.Uuid
  keyPrefix       String                 @unique @map("key_prefix") @db.VarChar(16)
  encryptedSecret String                 @map("encrypted_secret") @db.VarChar(255)
  status          DeviceCredentialStatus @default(active)
  expiresAt       DateTime?              @map("expires_at")
  lastUsedAt      DateTime?              @map("last_used_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  revokedAt       DateTime?              @map("revoked_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_credentials")
}

/// MQTT broker credential, separate from DeviceCredential (the HMAC key used
/// for HTTP ingestion) - a device gets one of each once MQTT is wired up.
/// Auth is checked via mosquitto-go-auth's HTTP backend mode calling out to
/// MqttPluginAuthController, not by the plugin querying this table directly.
model DeviceMqttCredential {
  id                String                 @id @default(uuid()) @db.Uuid
  deviceId          String                 @unique @map("device_id") @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  mqttUsername      String                 @unique @map("mqtt_username") @db.VarChar(64)
  passwordHash      String                 @map("password_hash") @db.VarChar(255)
  status            DeviceCredentialStatus @default(active)
  // True only while this device is still using the fixed, non-secret
  // MQTT_DEFAULT_DEVICE_PASSWORD every self-provisioned device starts with
  // (see ReaderOpsFleetService.registerDevice()/restoreDevice()) - flipped
  // to false the moment MqttDeviceTelemetrySubscriberService auto-rotates it
  // to a real random password after the device's first confirmed online
  // status. A device stuck true here for a long time signals it never
  // actually connected with its real credential.
  isDefaultPassword Boolean                @default(false) @map("is_default_password")
  lastUsedAt        DateTime?              @map("last_used_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  revokedAt         DateTime?              @map("revoked_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([tenantId])
  @@map("device_mqtt_credentials")
}

/// Latest known GPI port states, updated by MqttGpioSubscriberService on
/// every transition the reader publishes to devices/<tenantId>/<deviceId>/gpi.
/// One row per device (upserted, not history) - the running audit trail of
/// every transition lives in AuditLog instead (action:
/// 'device.gpi_changed'), this table is only "what's true right now".
model DeviceGpioState {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @unique @map("device_id") @db.Uuid
  gpiStates Json     @map("gpi_states") // {"<port>": true|false, ...}
  updatedAt DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_gpio_states")
}

model DeviceReaderConfig {
  id                    String    @id @default(uuid()) @db.Uuid
  deviceId              String    @unique @map("device_id") @db.Uuid
  ipMode                String    @default("dhcp") @map("ip_mode") @db.VarChar(10)
  staticIp              String?   @map("static_ip") @db.VarChar(64)
  staticSubnetMask      String?   @map("static_subnet_mask") @db.VarChar(64)
  staticGateway         String?   @map("static_gateway") @db.VarChar(64)
  staticDnsPrimary      String?   @map("static_dns_primary") @db.VarChar(64)
  staticDnsSecondary    String?   @map("static_dns_secondary") @db.VarChar(64)
  hostname              String?   @db.VarChar(100)
  managementIp          String?   @map("management_ip") @db.VarChar(64)
  managementPort        Int?      @map("management_port")
  reportingTransport    String    @default("https_post") @map("reporting_transport") @db.VarChar(20)
  reportingEndpointUrl  String?   @map("reporting_endpoint_url") @db.VarChar(500)
  reportingIntervalSec  Int?      @map("reporting_interval_sec")
  tcpSocketPort         Int?      @map("tcp_socket_port")
  serialBaudRate        Int?      @map("serial_baud_rate")
  mqttBridgeEnabled     Boolean   @default(false) @map("mqtt_bridge_enabled")
  mqttBrokerUrl         String?   @map("mqtt_broker_url") @db.VarChar(500)
  mqttTopic             String?   @map("mqtt_topic") @db.VarChar(255)
  syncStatus            String    @default("pending") @map("sync_status") @db.VarChar(20)
  lastExportedAt        DateTime? @map("last_exported_at")
  lastConfirmedAt       DateTime? @map("last_confirmed_at")
  syncNote              String?   @map("sync_note") @db.VarChar(500)
  // Optimistic/best-effort - set by ReaderOperationService on a successful
  // start/stop LLRP call, not a live poll of the physical reader. Same
  // tolerance-for-drift as syncStatus above.
  isReading             Boolean   @default(false) @map("is_reading")
  readingStateUpdatedAt DateTime? @map("reading_state_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_reader_configs")
}

model DeviceAntennaConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  deviceId           String    @map("device_id") @db.Uuid
  antennaPort        Int       @map("antenna_port")
  enabled            Boolean   @default(true)
  txPowerDbm         Float?    @map("tx_power_dbm")
  rxSensitivityDbm   Float?    @map("rx_sensitivity_dbm")
  txPowerIndex       Int?      @map("tx_power_index")
  rxSensitivityIndex Int?      @map("rx_sensitivity_index")
  syncStatus         String    @default("pending") @map("sync_status") @db.VarChar(20)
  lastSyncedAt       DateTime? @map("last_synced_at")
  lastSyncError      String?   @map("last_sync_error") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, antennaPort])
  @@index([deviceId])
  @@map("device_antenna_configs")
}

/// Standalone operator login for the Reader Ops fleet-control tool -
/// deliberately separate from both tenant users and PlatformAdmin (which
/// carries its own TOTP/MFA + tenant-management scope this tool doesn't
/// need). No public signup endpoint; seeded via a one-off script.
model ReaderOpsOperator {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique @db.VarChar(255)
  passwordHash     String   @map("password_hash") @db.VarChar(255)
  // Same TOTP + recovery-code shape as PlatformAdmin's MFA (see
  // mfa.util.ts - shared, generic, reused here) but with its OWN encryption
  // key (READER_OPS_MFA_ENCRYPTION_KEY) so a leak of one operator realm's
  // key never exposes the other's secrets.
  mfaSecret        String?  @map("mfa_secret") @db.VarChar(255)
  mfaEnabled       Boolean  @default(false) @map("mfa_enabled")
  mfaRecoveryCodes String[] @map("mfa_recovery_codes")

  // isActive = reversible suspend; deletedAt trio = one-way delete. Same
  // split as User / PlatformAdmin (this is a login account with MFA).
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  deletedByType String?   @map("deleted_by_type") @db.VarChar(20)
  deletedById   String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reader_ops_operators")
}

