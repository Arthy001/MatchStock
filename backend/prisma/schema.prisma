datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// Enums - only for fields where the full value set is confirmed with certainty
// from the original TypeORM entities/services built this session. Fields with
// an uncertain/open-ended value set stay String, matching the original Oracle
// schema (which never enforced these as DB-level enums either).
// =============================================================================

enum TenantStatus {
  active
  suspended
}

enum DeviceStatus {
  active
  inactive
  decommissioned
}

enum DeviceCredentialStatus {
  active
  revoked
}

enum TagStatus {
  unbound
  bound
  retired
}

enum TagCurrentStatus {
  unknown
  in_stock
  exited
  missing
}

enum TagEventType {
  first_seen
  zone_change
  missing
  reappeared
  exited
  bound
  unbound
  transferred
  adjusted
  received
}

enum TagEventReferenceType {
  goods_receipt
  goods_issue
  stock_transfer
  stock_adjustment
  cycle_count
}

enum UnitType {
  quantity
  dimension
  weight
}

enum DiscountType {
  percentage
  fixed
}

enum StockTransferStatus {
  pending
  completed
  cancelled
}

enum CycleCountStatus {
  open
  closed
  approved
}

enum StockAdjustmentReason {
  damaged
  lost
  found
  recount
  other
}

enum SubscriptionPlanType {
  web
  hardware
}

enum BillingCycle {
  monthly
  yearly
}

enum RentalUnitCondition {
  new
  good
  fair
  damaged
  unusable
}

enum PlatformAdminRole {
  super_admin
  billing
  support
}

enum PaymentProvider {
