# MatchStock Frontend Environment Variables

# Back-End API URL
# - สำหรับรัน Local: http://localhost:8080/api/v1
# - สำหรับรัน Staging: https://matchstock-api-staging-xxxx.a.run.app/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# เปิดใช้งาน Mock Data อัตโนมัติเมื่อต่อ API ไม่ได้ (true / false)
VITE_ENABLE_MOCK_FALLBACK=true
